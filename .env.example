# Servidor
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL (obligatoria)
DATABASE_URL=postgresql://usuario:password@localhost:5432/sicov_ci2?schema=public

# Autenticacion JWT
# Minimo 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h

# CORS (origen del frontend Angular)
CORS_ORIGIN=http://localhost:4200

# Hash de contrasenas
BCRYPT_ROUNDS=10

# Seed inicial (solo lo usa `npm run prisma:seed`)
SEED_PASSWORD=SicovCI2*2026
